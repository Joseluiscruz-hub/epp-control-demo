# ============================================
# CONTROL DE EPP — Variables de Entorno
# Copia este archivo como .env.local y rellena los valores
# ============================================

# --- Firebase Configuration ---
# Obtén estos valores en: https://console.firebase.google.com/
# Proyecto → Configuración del proyecto → Tus aplicaciones → Config SDK

NEXT_PUBLIC_FIREBASE_API_KEY=tu-api-key-aqui
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=tu-proyecto.firebaseapp.com
NEXT_PUBLIC_FIREBASE_PROJECT_ID=tu-proyecto-id
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=tu-proyecto.appspot.com
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=123456789
NEXT_PUBLIC_FIREBASE_APP_ID=1:123:web:abc123
NEXT_PUBLIC_FIREBASE_MEASUREMENT_ID=G-XXXXXXXXXX

# Firestore Database ID (si usas una DB diferente a "(default)")
# Déjalo vacío o como "(default)" si usas la base de datos por defecto
NEXT_PUBLIC_FIREBASE_DATABASE_ID=(default)

# --- Google Gemini API Key (para el Chatbot ARIA) ---
# Obtén tu API Key GRATIS en: https://aistudio.google.com/app/apikey
# ⚠️ IMPORTANTE: Esta variable NO tiene prefijo NEXT_PUBLIC_ para que sea segura (solo servidor)
GEMINI_API_KEY=tu-api-key-aqui

# --- Seguridad de producción ---
# Productivo: mantener offline desactivado. Activarlo sólo para demo local controlada.
NEXT_PUBLIC_ENABLE_OFFLINE_MODE=false

# Bootstrap temporal de emergencia. La fuente de verdad debe ser users/{uid}.
ENABLE_BOOTSTRAP_ADMIN=false
BOOTSTRAP_ADMIN_EMAIL=

# Producción: usar una Web App registrada en App Check y mantener enforcement activo.
# Desarrollo local: puedes dejar FIREBASE_APP_CHECK_REQUIRED=false si no tienes token debug.
# Produccion/Cloud Run: debe ser true. Usa false solo como contingencia temporal mientras corriges App Check.
NEXT_PUBLIC_FIREBASE_APPCHECK_SITE_KEY=
NEXT_PUBLIC_FIREBASE_APP_CHECK_REQUIRED=false
FIREBASE_APP_CHECK_REQUIRED=false

# Sal privada para hashear IPs en audit_events y llaves de rate limit.
# En produccion debe venir de Secret Manager (ver docs/deployment.md); si falta,
# los eventos de auditoria se guardan sin ipHash y se registra una advertencia.
AUDIT_IP_SALT=

# Proxies confiables que agregan su IP a X-Forwarded-For. Cloud Run directo: 1.
# Usa 2 solo si hay un balanceador HTTPS externo delante de Cloud Run.
TRUSTED_PROXY_HOPS=1

# Secreto aleatorio de al menos 32 caracteres para firmar sesiones opacas del kiosko.
# Debe ser distinto por ambiente y almacenarse en Secret Manager en produccion.
KIOSK_SESSION_SECRET=

# Solo para demos locales aisladas. El codigo ignora esta variable en produccion.
NEXT_PUBLIC_ENABLE_INSECURE_KIOSK_LOCAL_AUTH=false

# Aprobadores de alertas de reposicion anticipada (JSON). Contiene datos personales:
# en produccion guardalo en Secret Manager, NUNCA en el repositorio. Sin esto nadie
# queda autorizado por lista (los admin_global y quienes tengan permiso explicito si pueden).
# Formato: {"plants":{"norte":[{"employeeId":"1000001","name":"Nombre","email":"correo@dominio.com"}]},"global":[{"name":"Admin","email":"admin@dominio.com"}]}
KIOSK_ALERT_APPROVERS=

# Transicion: acepta PINs guardados con el hash heredado debil (se migran a bcrypt al primer acceso).
# Dejalo en false/vacio; los colaboradores sin migrar deben recibir un reinicio de credenciales.
KIOSK_ALLOW_LEGACY_PIN=false
